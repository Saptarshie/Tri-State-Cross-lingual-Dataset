# Example environment file. Copy to .env and fill in real values.
# The API key is never written to logs, artefacts, or dataset records.
LLM_BASE_URL=https://api.commandcode.ai/provider/v1
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash
LLM_MAX_TOKENS=64000

# Translation branch uses LLM_API_KEY by default. Set a separate key here only
# if you deliberately want an isolated translation credential.
# DEEPSEEK_API_KEY=

# Local embeddings (Ollama). Falls back to a deterministic hashing embedder.
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBED_MODEL=embeddinggemma
